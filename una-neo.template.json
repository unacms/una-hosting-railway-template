{
  "code": "una-template",
  "repo": "https://github.com/unacms/una-hosting-railway-template",
  "branch": "main",
  "services": {
    "db": {
      "image": "mariadb:13.0.2",
      "default": true,
      "public": false,
      "scale": {
        "us-west": 1
      },
      "variables": [
        "MARIADB_DATABASE",
        "MARIADB_USER",
        "MARIADB_PASSWORD",
        "MARIADB_ROOT_PASSWORD"
      ]
    },
    "soketi": {
      "image": "quay.io/soketi/soketi:e446df8e3e06b8430d75cf58555bc409bf240a4e-16-alpine",
      "default": true,
      "public": true,
      "scale": {
        "us-west": 1
      },
      "variables": [
        "SOKETI_DEFAULT_APP_ID",
        "SOKETI_DEFAULT_APP_KEY",
        "SOKETI_DEFAULT_APP_SECRET",
        "PORT",
        "SOKETI_HOST",
        "SOKETI_DEFAULT_APP_ENABLE_CLIENT_MESSAGES"
      ]
    },
    "una": {
      "image": "unaio/una:latest",
      "root": "/services/una",
      "default": true,
      "public": true,
      "requires": [
        "db"
      ],
      "scale": {
        "us-west": 1
      },
      "variables": [
        "UNA_SITE_EMAIL",
        "UNA_ADMIN_EMAIL",
        "UNA_SITE_TITLE",
        "UNA_ADMIN_PWD",
        "UNA_KEY",
        "UNA_SECRET",
        "UNA_ZIP_DOWNLOAD_URL",
        "UNA_ZIP_FOLDER",
        "UNA_HTTP_HOST",
        "HTTPS",
        "PORT",
        "UNA_DB_HOST",
        "UNA_DB_PORT",
        "UNA_DB_USER",
        "UNA_DB_PWD",
        "UNA_DB_NAME",
        "UNA_JOT_SERVER_URL",
        "UNA_JOT_JWT_SECRET",
        "UNA_SMTP_HOST",
        "UNA_SMTP_PORT",
        "UNA_SOCKETS_URL",
        "SOKETI_SECRET",
        "NEO_UNA_API_KEY"
      ]
    },
    "neo": {
      "image": "unaio/neo:latest",
      "root": "/services/neo",
      "default": true,
      "public": true,
      "scale": {
        "us-west": 1
      },
      "variables": [
        "logo",
        "splash_text_component",
        "join_text_component",
        "global_css_component",
        "PORT",
        "UNA_API_KEY",
        "UNA_URL",
        "NEXT_PUBLIC_UNA_URL",
        "NEO_IMAGE_HOST",
        "NEXT_PUBLIC_SOCKETS_HOST",
        "NEXT_PUBLIC_SOCKETS_KEY"
      ]
    },
    "phpmyadmin": {
      "image": "phpmyadmin:5.2.3",
      "root": "/services/phpmyadmin",
      "default": false,
      "public": true,
      "requires": [
        "db"
      ],
      "scale": {
        "us-west": 1
      },
      "variables": [
        "PORT",
        "PMA_HOST",
        "PMA_PORT",
        "UPLOAD_LIMIT"
      ]
    },
    "jot": {
      "image": "unaio/jot-server:latest",
      "root": "/services/jot",
      "default": false,
      "public": true,
      "scale": {
        "us-west": 1
      },
      "variables": [
        "JOT_JWT_SECRET",
        "PORT",
        "RAILWAY_RUN_UID"
      ]
    },
    "mail": {
      "image": "namshi/smtp",
      "default": false,
      "public": false,
      "scale": {
        "us-west": 1
      },
      "variables": [
        "PORT",
        "MAILNAME",
        "RELAY_NETWORKS"
      ]
    }
  }
}
